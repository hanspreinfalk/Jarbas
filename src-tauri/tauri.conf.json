{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jarbas",
  "version": "0.1.0",
  "identifier": "com.hanspreinfalk.jarbas",
  "build": {
    "beforeDevCommand": "npm run fetch-node && npm run fetch-ffmpeg && npm run stage-screenpipe && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run fetch-node && npm run fetch-ffmpeg && npm run stage-screenpipe && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Deployment Company of San Francisco",
        "width": 1180,
        "height": 780,
        "minWidth": 920,
        "minHeight": 640,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/nodejs/",
      "resources/pi/",
      "resources/screenpipe/",
      "resources/ffmpeg/"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    }
  }
}
