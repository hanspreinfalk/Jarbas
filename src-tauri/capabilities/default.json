{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window (local + localhost UI origins).",
  "windows": ["main"],
  "local": true,
  "remote": {
    "urls": [
      "http://localhost:1420/*",
      "http://localhost:1421/*",
      "http://127.0.0.1:1420/*",
      "http://127.0.0.1:1421/*"
    ]
  },
  "permissions": [
    "core:default",
    "opener:default",
    "allow-open-privacy-settings",
    "allow-list-composio-toolkits",
    "allow-list-composio-connected-accounts",
    "allow-create-composio-connect-link",
    "allow-delete-composio-connected-account",
    "allow-set-composio-api-key",
    "allow-sync-org-seat-limit",
    "allow-get-pi-agent-status",
    "allow-ensure-pi-agent-installed",
    "allow-get-llm-settings",
    "allow-set-llm-api-key",
    "allow-clear-llm-api-key",
    "allow-set-llm-model",
    "allow-ask-send-prompt",
    "allow-ask-abort",
    "allow-ask-new-session",
    "allow-list-analysis-items",
    "allow-delete-analysis-item",
    "allow-update-analysis-item",
    "allow-get-analysis-status",
    "allow-start-analysis",
    "allow-abort-analysis",
    "allow-screenpipe-default-paths",
    "allow-screenpipe-permissions",
    "allow-screenpipe-start",
    "allow-screenpipe-stop",
    "allow-screenpipe-status",
    "allow-screenpipe-snapshot",
    "allow-screenpipe-reveal",
    "allow-screenpipe-dispose",
    "allow-screenpipe-events",
    "allow-screenpipe-identify",
    "allow-capture-last-session",
    "allow-capture-storage-stats",
    "allow-reset-jarbas-data",
    "allow-redact-jarbas-capture",
    "allow-get-last-redaction",
    "allow-get-redaction-history",
    "allow-get-redaction-prefs",
    "allow-set-auto-redact-on-stop",
    "allow-set-enabled-redaction-categories",
    "allow-get-capture-filters",
    "allow-set-capture-filters"
  ]
}
