COMPOSIO_API_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Convex (also written to .env.local by `npx convex deployment create --select`)
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=

# Packaged app auth origin is http://localhost:1421 (not tauri://).
# In Clerk Dashboard → Configure → Domains / allowed origins, allow:
#   http://localhost:1420  (tauri dev)
#   http://localhost:1421  (packaged app)

# macOS code signing + notarization (required for `npm run tauri:dmg`)
# Quote values that contain spaces or parentheses.
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"
CSC_NAME="Your Name (TEAMID)"
APPLE_ID="you@example.com"
APPLE_APP_SPECIFIC_PASSWORD=""
APPLE_TEAM_ID=""
